# Скопируйте в .env и заполните. Без .env compose использует dev-значения.

# --- Telegram ---
# Токен от @BotFather. Без него бот не запускается, но Mini App работает.
BOT_TOKEN=
# Публичный HTTPS-URL, по которому открывается Mini App (не localhost!).
# Пример: https://dropzone.example.com
WEBAPP_URL=http://localhost:3000

# --- Безопасность ---
# Обязательно замените в production: openssl rand -hex 32
JWT_SECRET=change-this-development-secret
# true — разрешает вход без Telegram initData (демо в браузере).
# В production поставьте false.
DEV_MODE=true
ENVIRONMENT=development

# Telegram usernames с доступом к админке (через запятую, без @).
ADMIN_USERNAMES=anxiohalcy

# --- Postgres ---
POSTGRES_DB=roulette
POSTGRES_USER=roulette
POSTGRES_PASSWORD=roulette

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Порты на хосте ---
# 127.0.0.1 — безопасный default: наружу смотрит только reverse-proxy.
# Для GitHub Codespaces можно поставить 0.0.0.0, чтобы работал Port forwarding.
BIND_HOST=127.0.0.1
APP_PORT=3000
BACKEND_PORT=8000
